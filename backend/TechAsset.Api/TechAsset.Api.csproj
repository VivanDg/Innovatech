      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TechAsset.Application\TechAsset.Application.csproj" />
    <ProjectReference Include="..\TechAsset.Infrastructure\TechAsset.Infrastructure.csproj" />
  </ItemGroup>

</Project>
